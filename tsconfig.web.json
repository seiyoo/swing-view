{
  "compilerOptions": {
    "composite": true, "module": "ESNext", "moduleResolution": "Bundler",
    "target": "ES2020", "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "baseUrl": ".",
    "paths": { "@renderer/*": ["src/renderer/src/*"], "@shared/*": ["src/shared/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/index.d.ts"]
}
